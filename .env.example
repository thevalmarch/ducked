# ── Ducked Engine — Environment Variables ────────────────────────
# Copy this file to .env and modify as needed.
#
#   cp .env.example .env
#
# All variables are optional. The engine runs with sensible defaults.

# ── Discord Alerts ───────────────────────────────────────────────
# Optional webhook URL for operational alerts (rate limits, errors, etc.)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ── Traefik / TLS ────────────────────────────────────────────────
# Email for Let's Encrypt certificate registration (used in docker-compose.yml)
# ACME_EMAIL=thevalmarch@gmail.com

# ── API Server ─────────────────────────────────────────────────
# Port for the FastAPI engine to listen on (default: 9000)
# API_PORT=9000

# ── Git Forges ───────────────────────────────────────────────────
# Extra hosts the engine may clone from, comma separated. Appended to the
# built-in defaults (github.com, gitlab.com, codeberg.org, gitea.com).
#
# SECURITY: this is an allowlist, not a convenience setting. git clone runs
# server-side, so every host listed here is a host the engine will connect
# to on a user's behalf. Only add instances you control or trust, and never
# widen this to arbitrary hosts.
#
# Include the port if the instance uses a non-standard one — the whole
# authority must match.
# GIT_ALLOWED_HOSTS=git.example.com,forge.internal:3000
